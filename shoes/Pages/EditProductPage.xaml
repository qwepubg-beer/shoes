<Page x:Class="shoes.Pages.EditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:shoes.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditProductPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image x:Name="ProductImage" MaxHeight="300" MaxWidth="200" VerticalAlignment="Center" Stretch="Uniform"/>
            <Button Name="EditPath" Content="Изменить фото" Grid.Row="1" MaxHeight="40" MaxWidth="200"/>
        </Grid>
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditPanel">
                    <TextBlock Text="Название:"/>
                    <TextBox x:Name="TxtName" Margin="0,0,0,5"/>
                    <TextBlock Text="Описание:"/>
                    <TextBox x:Name="TxtDescription" Margin="0,0,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock Text="Категория:"/>
                    <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,0,0,5"/>
                   <TextBlock Text="Производитель:"/>
                    <ComboBox x:Name="CmbManufactorer" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="Поставщик:"/>
                    <ComboBox x:Name="CmbSupplier" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="Цена:"/>
                    <TextBox x:Name="TxtPrice" Margin="0,0,0,5"/>
                   <TextBlock Text="Количество:"/>
                    <TextBox x:Name="TxtQuantity" Margin="0,0,0,5"/>
                    <TextBlock Text="Единица измерения:"/>
                    <ComboBox x:Name="CmbUnit" DisplayMemberPath="Name" SelectedValuePath="ID" Margin="0,0,0,5"/>
                    <TextBlock Text="Скидка (%):"/>
                    <TextBox x:Name="TxtDiscount" Margin="0,0,0,5"/>
                    <CheckBox x:Name="ChkIsActive" Content="Активен" Margin="0,10,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAdd" Content="Добавить" Width="90" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSave" Content="Сохранить" Width="90" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDelete" Content="Удалить" Width="90" Height="30"/>
                    </StackPanel>
                    <Button x:Name="BtnClear" Content="Очистить форму" Width="290" Height="30" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
