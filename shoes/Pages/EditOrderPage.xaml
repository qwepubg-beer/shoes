<Page x:Class="shoes.Pages.EditOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:shoes.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditOrderPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditPanel">
                    <TextBlock Text="Артикул:"/>
                    <TextBox x:Name="Article" Margin="0,0,0,5"/>
                    <TextBlock Text="Статус заказа:"/>
                    <ComboBox x:Name="CmbStatatus" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="Адрес пункта выдачи:"/>
                    <ComboBox x:Name="CmbDeviveryPoint" DisplayMemberPath="adress" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="Дата заказа:"/>
                    <DatePicker Name="OrderDatePicker"></DatePicker>
                    <TextBlock Text="Дата доставки"/>
                    <DatePicker Name="DiliveryDatePicker"></DatePicker>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAdd" Content="Добавить" Width="90" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSave" Content="Сохранить" Width="90" Height="30" Margin="0,0,10,0" />
                        <Button x:Name="BtnDelete" Content="Удалить" Width="90" Height="30"/>
                    </StackPanel>
                    <Button x:Name="BtnClear" Content="Очистить форму" Width="290" Height="30" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
