<Page x:Class="shoes.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:shoes.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid Name="AdminMenu" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="Search" Height="40"></TextBox>
            <ComboBox x:Name="TypeProductComboBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Id" Height="40"></ComboBox>
            <ComboBox x:Name="SortComboBox" Grid.Column="2" IsEditable="True" Height="40">
                <ComboBoxItem Content="Цена убывание"></ComboBoxItem>
                <ComboBoxItem Content="Цена возрастание"></ComboBoxItem>
            </ComboBox>
            <Button Name="GoToEditWindow" Grid.Column="3" Content="Изменить" Visibility="Collapsed"/>
            <Button Name="GoToAddWindow"  Grid.Column="4" Content="Добавить" Visibility="Collapsed"/>
        </Grid>
        <ListView Name="ProductsListView" HorizontalContentAlignment="Stretch" Grid.Row="1" Margin="0,5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Width="130" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding ProductImagePath}" Stretch="Uniform" MaxHeight="200" MaxWidth="300"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0,15,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Product_Category.Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text=" | " FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Margin="0,2"><Run Text="Описание товара: "/><Run Text="{Binding Description}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Производитель: "/><Run Text="{Binding Manufactorer.Name}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Поставщик: "/><Run Text="{Binding Suppliers.Name}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Цена: "/><Run Text="{Binding Price, StringFormat={}{0:C}}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Единица измерения: "/><Run Text="{Binding Units.Name}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Количество: "/><Run Text="{Binding Quantity}"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая" HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="скидка" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
