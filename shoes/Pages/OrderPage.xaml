<Page x:Class="shoes.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:shoes.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid Name="AdminMenu" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button Name="GoToEditWindow" Grid.Column="3" Content="Изменить" />
            <Button Name="GoToAddWindow"  Grid.Column="4" Content="Добавить" />
        </Grid>
        <ListView Name="OrdersListView" HorizontalContentAlignment="Stretch" Grid.Row="1" Margin="0,5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Width="130" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding ProductImagePath}" Stretch="Uniform" MaxHeight="200" MaxWidth="300"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15,0,15,0" VerticalAlignment="Center">
                                <TextBlock Margin="0,2"><Run Text="Артикул заказа: "/><Run Text="{Binding Id}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Статус заказа: "/><Run Text="{Binding Order_Status.Name}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Адрес пункта выдачи заказа: "/><Run Text="{Binding DeliveryPoint.Name}"/></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="Дата заказа: "/><Run Text="{Binding OrderDate, StringFormat={}{0:dd MMMM yyyy 'г.'}}"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
