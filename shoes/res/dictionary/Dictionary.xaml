<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Times New Roman</FontFamily>
    <SolidColorBrush x:Key="MainColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondColor" Color="#7FFF00"/>
    <SolidColorBrush x:Key="AttentionColor" Color="#00FA9A"/>
    <SolidColorBrush x:Key="DiscountColor" Color="#2E8B57"/>
    <Style x:Key="BaseWindowStyle" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="{StaticResource MainColor}"></Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Margin" Value="5"></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="5"></Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Margin" Value="5"></Setter>
        <Setter Property="Background" Value="{StaticResource SecondColor}"></Setter>
    </Style>
</ResourceDictionary>